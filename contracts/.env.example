# Copy to .env and fill in locally. Never commit .env.
# Names only here; no values. Foundry loads contracts/.env automatically.

# Arc testnet RPC (e.g. your QuickNode Arc testnet endpoint)
ARC_TESTNET_RPC_URL=

# Public address of the `deployer` keystore account (shown by `cast wallet address --account deployer`).
# This is an ADDRESS, not a private key. Never put a private key in this file.
DEPLOYER_ADDRESS=

# Testnet wallets that receive each license payment
TREASURY_ADDRESS=
RIGHTS_HOLDER_ADDRESS=
CONTRIBUTOR_ADDRESS=

# Filled in after Deploy.s.sol prints the deployed address
SNIPPET_LICENSES_ADDRESS=

# Local testing only (anvil + MockUSDC). Leave commented out for Arc testnet, which uses the
# 0x3600...0000 USDC ERC-20 by default. An empty value would break the deploy script.
# USDC_ADDRESS=
