# Copy to .env and fill in locally. Never commit .env.
# Names only here; no values.

# Arc testnet RPC (e.g. your QuickNode Arc testnet endpoint)
ARC_TESTNET_RPC_URL=

# Name of the Foundry keystore account that deploys (created with `cast wallet import`).
# This is a NAME, not a private key. Never put a private key in this file.
DEPLOYER_ACCOUNT=

# Testnet wallets that receive each license payment
TREASURY_ADDRESS=
RIGHTS_HOLDER_ADDRESS=
CONTRIBUTOR_ADDRESS=
