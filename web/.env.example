# Copy to .env and fill in locally. Never commit .env.
# Names only here; no values.
# NEXT_PUBLIC_ variables are sent to the browser: never put secrets in them.

# Arc testnet RPC URL used by the browser wallet connection
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=

# Optional: WalletConnect project ID from https://cloud.reown.com (enables phone wallets)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# SnippetLicenses contract address (official: 0xfc6a8dd5569ff53ca64065fac5eb17677ad1fe20)
NEXT_PUBLIC_SNIPPET_LICENSES_ADDRESS=

# Supabase (Settings > API Keys, and the Connect dialog for the URL)
# Browser safe: the publishable key can only read license_events (Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY, never NEXT_PUBLIC_: the secret key bypasses Row Level Security. Used by /api/streams.
SUPABASE_SECRET_KEY=

# SERVER ONLY: the QuickNode Stream's security token (Stream > Settings). Verifies webhook signatures.
QUICKNODE_STREAMS_SECURITY_TOKEN=

# SERVER ONLY, never NEXT_PUBLIC_: ElevenLabs API key (Speech to Text). Used only by scripts/transcribe.mjs
# on your laptop, not by the deployed site.
ELEVENLABS_API_KEY=
