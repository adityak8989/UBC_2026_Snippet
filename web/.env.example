# Copy to .env and fill in locally. Never commit .env.
# Names only here; no values.
# NEXT_PUBLIC_ variables are sent to the browser: never put secrets in them.

# Arc testnet RPC URL used by the browser wallet connection
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=

# Optional: WalletConnect project ID from https://cloud.reown.com (enables phone wallets)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# SnippetLicenses contract address (filled in after Tuesday's deploy)
NEXT_PUBLIC_SNIPPET_LICENSES_ADDRESS=
